PROJECT_NAME=Ticket Intelligent Triage API
API_V1_STR=/api/v1

# REQUIRED
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/ticket_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/ticket_db_test
OPENAI_API_KEY=sk-your-key-here
AI_MODEL_NAME=gpt-6-luna

# OPTIONAL
AI_PROVIDER=openai
AI_BASE_URL=

# REQUIRED
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRE_DAYS=7

# Integración con el módulo del compañero (opcional)
COMPANERO_API_URL=
COMPANERO_API_KEY=
COMPANERO_API_TIMEOUT_SECONDS=5
COMPANERO_API_ENABLED=false
